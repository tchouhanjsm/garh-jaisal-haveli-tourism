{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotelgarhjaisal.com/schemas/tour.schema.json",
  "title": "Garh Jaisal Tour Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "title",
    "seo",
    "status",
    "summary",
    "timeline",
    "included",
    "notIncluded",
    "factsConfirmed",
    "lastVerified"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 90
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 80
    },
    "category": {
      "enum": [
        "desert",
        "city",
        "multi-day",
        "other"
      ]
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 110,
          "maxLength": 160
        },
        "ogImage": {
          "type": "string",
          "pattern": "^assets/images/tours/[a-z0-9-]+/[a-z0-9-]+-og-01\\.(webp|avif)$"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "approved_for_release",
        "live",
        "hidden"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 400
    },
    "bestFor": {
      "type": "string",
      "maxLength": 500
    },
    "duration": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "overnight": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "transport": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 250
    },
    "startingPoint": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 250
    },
    "timingNote": {
      "type": "string",
      "maxLength": 500
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "title",
          "description"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "timeOfDay": {
            "type": "string",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "image": {
            "type": "string",
            "pattern": "^assets/images/tours/[a-z0-9-]+/[a-z0-9-]+-(step|gallery|detail)-[0-9]{2}\\.(webp|avif)$"
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "included": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 250
      }
    },
    "notIncluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 250
      }
    },
    "practicalNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 250
          },
          "answer": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "relatedTours": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "relatedBlogs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "enquiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "label"
      ],
      "properties": {
        "mode": {
          "enum": [
            "whatsapp",
            "booking_gateway",
            "contact"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "factsConfirmed": {
      "type": "boolean"
    },
    "factSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "source",
          "verifiedOn",
          "verifiedBy"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 2
          },
          "verifiedOn": {
            "type": "string",
            "format": "date"
          },
          "verifiedBy": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "lastVerified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
