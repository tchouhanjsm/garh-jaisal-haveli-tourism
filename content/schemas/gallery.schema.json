{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotelgarhjaisal.com/schemas/gallery.schema.json",
  "title": "Garh Jaisal Curated Gallery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "category",
    "title",
    "status",
    "images"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "category": {
      "enum": [
        "hotel",
        "rooms",
        "desert",
        "restaurant"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "approved_for_release",
        "live",
        "hidden"
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "src",
          "alt",
          "source",
          "approved"
        ],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^assets/images/gallery/[a-z0-9-]+/[a-z0-9-]+-[a-z]+-[0-9]{2}\\.(webp|avif)$"
          },
          "alt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "caption": {
            "type": "string",
            "maxLength": 250
          },
          "source": {
            "type": "string",
            "minLength": 2
          },
          "approved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
