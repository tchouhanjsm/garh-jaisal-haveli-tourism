# Apache/cPanel static-site rules. Review host aliases and verify behavior before deployment.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Normalize only the named production aliases; preserve the full URI and query string.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(?:www\.)?hotelgarhjaisal\.com$ [NC]
  RewriteRule ^ https://hotelgarhjaisal.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^www\.hotelgarhjaisal\.com$ [NC]
  RewriteRule ^ https://hotelgarhjaisal.com%{REQUEST_URI} [R=301,L,NE]

  # Non-canonical aliases keep discovery blocked without redirecting unknown hosts to production.
  RewriteCond %{HTTP_HOST} !^hotelgarhjaisal\.com$ [NC]
  RewriteRule ^robots\.txt$ robots-staging.txt [L]

  RewriteCond %{HTTP_HOST} !^hotelgarhjaisal\.com$ [NC]
  RewriteRule ^sitemap\.xml$ sitemap-empty.xml [L]

  SetEnvIfNoCase Host "^(?!hotelgarhjaisal\.com$).*" STAGING_HOST
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Robots-Tag "noindex, nofollow" env=STAGING_HOST
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
