# Apache/cPanel defaults for the static website.
ErrorDocument 404 /404.html

# Non-canonical hosts (staging, cPanel previews and aliases) stay non-indexable.
# The candidate canonical host also remains blocked by robots.txt until owner approval.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^hotelgarhjaisal\.com(?::\d+)?$ [NC]
  RewriteRule ^robots\.txt$ robots-staging.txt [L]
  RewriteCond %{HTTP_HOST} !^hotelgarhjaisal\.com(?::\d+)?$ [NC]
  RewriteRule ^sitemap\.xml$ sitemap-empty.xml [L]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^(?!hotelgarhjaisal\.com(?::\d+)?$).*" GJ_NONCANONICAL_HOST
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=GJ_NONCANONICAL_HOST
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
